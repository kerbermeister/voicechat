{
    admin off
    servers {
        trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
        trusted_proxies_strict
    }
}
{$SITE} {
    encode zstd gzip
    header {
        Cross-Origin-Opener-Policy same-origin
        Cross-Origin-Embedder-Policy require-corp
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    request_body {
        max_size 350MB
    }
    @private path /_synapse/admin/* /_synapse/client/voicechat/* /api/internal/* /api/report /api/reports
    route {
    respond @private 404
    handle_path /updates/android/* {
        root * /updates/android
        @metadata path /latest.json
        header @metadata Cache-Control "no-cache"
        @apk path_regexp apk ^/[0-9]+/voicechat\.apk$
        header @apk Content-Type application/vnd.android.package-archive
        header @apk Cache-Control "public, max-age=31536000, immutable"
        @published path_regexp published ^/(latest\.json|[1-9][0-9]*/voicechat\.apk)$
        route {
            file_server @published
            respond 404
        }
    }
    handle_path /updates/macos/* {
        root * /updates/macos
        @macosFeed path /appcast.xml
        header @macosFeed Cache-Control "no-cache"
        @macosArchive path_regexp macosArchive ^/[1-9][0-9]*/VoiceChat\.(zip|dmg)$
        header @macosArchive Cache-Control "public, max-age=31536000, immutable"
        @macosPublished path_regexp macosPublished ^/(appcast\.xml|[1-9][0-9]*/VoiceChat\.(zip|dmg))$
        route {
            file_server @macosPublished
            respond 404
        }
    }
    handle /_matrix/push/v1/notify {
        reverse_proxy control:8090
    }
    handle /_matrix/* {
        reverse_proxy synapse:8008
    }
    handle /_synapse/client/* {
        reverse_proxy synapse:8008
    }
    handle_path /api/* {
        reverse_proxy control:8090
    }
    handle /rtc* {
        reverse_proxy control:7880
    }
    handle {
        # Fixed entrypoint names must revalidate after a deployment.
        header Cache-Control "no-cache"
        root * /srv
        try_files {path} /index.html
        file_server {
            precompressed br gzip
        }
    }
    }
}
:8080 {
    respond /health 200
}
