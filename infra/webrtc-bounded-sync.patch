+TEST(VCMTimingTest, SyncDelayMeasuresRenderScheduleFromPacketReceipt) {
+  FieldTrials field_trials = CreateTestFieldTrials();
+  SimulatedClock clock(Timestamp::Millis(1000));
+  VCMTiming timing(&clock, field_trials);
+  timing.set_playout_delay({TimeDelta::Millis(70), TimeDelta::Millis(70)});
+  timing.OnCompleteTemporalUnit(90000, clock.CurrentTime());
+  clock.AdvanceTime(TimeDelta::Millis(60));
+
+  // The RTP clock predicts capture at 1010 ms and rendering at 1080 ms.
+  // Arrival at 1060 ms after a network change leaves only 20 ms to render.
+  EXPECT_EQ(timing.RenderTime(90900, clock.CurrentTime()),
+            Timestamp::Millis(1080));
+  EXPECT_EQ(timing.CurrentDelayFromReceive(90900, clock.CurrentTime()),
+            TimeDelta::Millis(20));
