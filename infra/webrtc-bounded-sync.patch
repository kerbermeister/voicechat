+package org.webrtc.audio;
+
+import static org.junit.Assert.assertEquals;
+
+import android.media.AudioTimestamp;
+import androidx.test.runner.AndroidJUnit4;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.annotation.Config;
+
+@RunWith(AndroidJUnit4.class)
+@Config(manifest = Config.NONE, sdk = {29, 36})
+public class WebRtcAudioTrackDelayTest {
+
+  private static final long NOW_NS = 10_000_000_000L;
+
+  /** При старом показании уже проигранные 20 мс вычитаются; исходные 100 мс неверны. */
+  @Test
+  public void testProjectsTimestampToCurrentOutput() {
+
+    AudioTimestamp timestamp = timestamp(1000, NOW_NS - 20_000_000L);
+
+    int delayMs = WebRtcAudioTrack.calculatePlayoutDelayMs(5800, 48000, timestamp, NOW_NS);
+
+    assertEquals(80, delayMs);
+  }
+
+  /** Частоты 8/48/192 кГц и неполная миллисекунда сохраняют единицы и округление вверх. */
+  @Test
+  public void testUsesDeviceRateAndRoundsUp() {
+
+    for (int rate : new int[] {8000, 48000, 192000}) {
+      AudioTimestamp timestamp = timestamp(0, NOW_NS);
+
+      int delayMs = WebRtcAudioTrack.calculatePlayoutDelayMs(rate / 10, rate, timestamp, NOW_NS);
+      int partialMs = WebRtcAudioTrack.calculatePlayoutDelayMs(1, rate, timestamp, NOW_NS);
+
+      assertEquals(100, delayMs);
+      assertEquals(1, partialMs);
+    }
+  }
+
+  /** После оборота 32-битной позиции остаётся очередь 100 мс, а не огромная задержка. */
+  @Test
+  public void testUnwrapsPlaybackFramePosition() {
+
+    AudioTimestamp timestamp = timestamp(1600, NOW_NS);
+
+    int delayMs = WebRtcAudioTrack.calculatePlayoutDelayMs(
+        (1L << 32) + 6400, 48000, timestamp, NOW_NS);
+
+    assertEquals(100, delayMs);
+  }
+
+  /** Отсутствующие и просроченные часы дают -1, чтобы прежняя оценка оставалась доступна. */
+  @Test
+  public void testRejectsUnknownAndStaleClocks() {
+
+    assertEquals(-1, WebRtcAudioTrack.calculatePlayoutDelayMs(4800, 48000, null, NOW_NS));
+    assertEquals(-1, WebRtcAudioTrack.calculatePlayoutDelayMs(
+        4800, 48000, timestamp(0, 0), NOW_NS));
+    assertEquals(-1, WebRtcAudioTrack.calculatePlayoutDelayMs(
+        4800, 48000, timestamp(0, NOW_NS - 1_000_000_001L), NOW_NS));
+    assertEquals(-1, WebRtcAudioTrack.calculatePlayoutDelayMs(
+        4800, 48000, timestamp(0, NOW_NS + 1_000_000_001L), NOW_NS));
+  }
+
+  /** Неверные счётчики, частота и позиция из другой эпохи отвергаются, а не дают ноль. */
+  @Test
+  public void testRejectsInvalidCountersAndResetEpoch() {
+
+    AudioTimestamp timestamp = timestamp(1000, NOW_NS);
+
+    assertEquals(-1, WebRtcAudioTrack.calculatePlayoutDelayMs(-1, 48000, timestamp, NOW_NS));
+    assertEquals(-1, WebRtcAudioTrack.calculatePlayoutDelayMs(4800, 0, timestamp, NOW_NS));
+    assertEquals(-1, WebRtcAudioTrack.calculatePlayoutDelayMs(4800, -1, timestamp, NOW_NS));
+    assertEquals(-1, WebRtcAudioTrack.calculatePlayoutDelayMs(999, 48000, timestamp, NOW_NS));
+    assertEquals(-1, WebRtcAudioTrack.calculatePlayoutDelayMs(
+        4800, 48000, timestamp(-1, NOW_NS), NOW_NS));
+  }
+
+  /** На обеих границах свежести 1 с показание допустимо; будущая позиция проецируется назад. */
+  @Test
+  public void testAcceptsFreshnessBoundaries() {
+
+    assertEquals(100, WebRtcAudioTrack.calculatePlayoutDelayMs(
+        52800, 48000, timestamp(0, NOW_NS - 1_000_000_000L), NOW_NS));
+    assertEquals(1100, WebRtcAudioTrack.calculatePlayoutDelayMs(
+        4800, 48000, timestamp(0, NOW_NS + 1_000_000_000L), NOW_NS));
+  }
+
+  /** Граница uint16_t проходит без обрезания; следующая миллисекунда даёт неизвестную оценку. */
+  @Test
+  public void testRejectsDelayOutsideNativeRange() {
+
+    AudioTimestamp timestamp = timestamp(0, NOW_NS);
+
+    assertEquals(65535, WebRtcAudioTrack.calculatePlayoutDelayMs(65535, 1000, timestamp, NOW_NS));
+    assertEquals(-1, WebRtcAudioTrack.calculatePlayoutDelayMs(65536, 1000, timestamp, NOW_NS));
+  }
+
+  /** Пустая или уже проигранная очередь даёт ноль, а не отрицательную задержку. */
+  @Test
+  public void testClampsDrainedQueueAtZero() {
+
+    assertEquals(0, WebRtcAudioTrack.calculatePlayoutDelayMs(
+        1000, 48000, timestamp(1000, NOW_NS), NOW_NS));
+    assertEquals(0, WebRtcAudioTrack.calculatePlayoutDelayMs(
+        1000, 48000, timestamp(0, NOW_NS - 100_000_000L), NOW_NS));
+  }
+
+  private static AudioTimestamp timestamp(long frames, long timeNs) {
+
+    AudioTimestamp timestamp = new AudioTimestamp();
+    timestamp.framePosition = frames;
+    timestamp.nanoTime = timeNs;
+
+    return timestamp;
+  }
