+TEST(VCMTimingTest, SyncTargetRespectsMaximumAfterVideoJitter) {
+  FieldTrials field_trials = CreateTestFieldTrials();
+  SimulatedClock clock(0);
+  VCMTiming timing(&clock, field_trials);
+  timing.set_playout_delay({TimeDelta::Millis(90), TimeDelta::Millis(90)});
+  timing.SetMinimumDelay(TimeDelta::Seconds(2));
+
+  EXPECT_EQ(timing.TargetVideoDelayForSync(), TimeDelta::Millis(90));
+  // Do not hide the oversized jitter estimate from the frame-buffer reset guard.
+  EXPECT_GT(timing.TargetVideoDelay(), TimeDelta::Seconds(2));
+}
+
+TEST(VCMTimingTest, SyncTargetPreservesSmallerTargetsAndMinimum) {
+  FieldTrials field_trials = CreateTestFieldTrials();
+  SimulatedClock clock(0);
+  VCMTiming timing(&clock, field_trials);
+  timing.set_playout_delay({TimeDelta::Millis(40), TimeDelta::Millis(130)});
+  timing.SetMinimumDelay(TimeDelta::Millis(5));
+  EXPECT_EQ(timing.TargetVideoDelayForSync(), TimeDelta::Millis(40));
+
+  timing.SetMinimumDelay(TimeDelta::Millis(50));
+  EXPECT_EQ(timing.TargetVideoDelayForSync(), timing.TargetVideoDelay());
+
+  timing.SetMinimumDelay(TimeDelta::Seconds(2));
+  EXPECT_EQ(timing.TargetVideoDelayForSync(), TimeDelta::Millis(130));
+  EXPECT_GT(timing.TargetVideoDelay(), TimeDelta::Seconds(2));
+}
