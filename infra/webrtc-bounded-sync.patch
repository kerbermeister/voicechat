+TEST_F(RtpStreamsSynchronizerTest, ReleasesFloorsWhenVideoStopsAndResumes) {
+  const TimeDelta previous = audio_.floor;
+  video_.receiving = false;
+  time_.AdvanceTime(TimeDelta::Seconds(1));
+  EXPECT_EQ(audio_.floor, previous);
+  time_.AdvanceTime(TimeDelta::Seconds(1));
+  EXPECT_EQ(audio_.floor, TimeDelta::Zero());
+  EXPECT_EQ(video_.floor, TimeDelta::Zero());
+  const int updates = audio_.updates;
+  time_.AdvanceTime(TimeDelta::Seconds(5));
+  EXPECT_EQ(audio_.updates, updates);
+  EXPECT_EQ(audio_.GetInfo()->current_delay, TimeDelta::Millis(40));
+  video_.receiving = true;
+  time_.AdvanceTime(TimeDelta::Seconds(12));
+  EXPECT_GT(audio_.floor, TimeDelta::Zero());
+  EXPECT_LE(audio_.floor, TimeDelta::Millis(80));
