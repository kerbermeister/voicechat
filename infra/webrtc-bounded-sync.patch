+namespace {
+class SyncTestStream : public Syncable {
+ public:
+  SyncTestStream(Clock* clock, uint32_t id, int frequency, int delay_ms)
+      : delay_ms(delay_ms), clock_(clock), id_(id), frequency_(frequency),
+        last_receive_(clock->CurrentTime()) {}
+  uint32_t id() const override { return id_; }
+  std::optional<Info> GetInfo() const override {
+    if (!has_info) return std::nullopt;
+    if (receiving) last_receive_ = clock_->CurrentTime() - receive_age;
+    const uint32_t timestamp = last_receive_.ms() * frequency_ / 1000 + rtp_offset;
+    const Timestamp report = report_time.value_or(last_receive_);
+    const int64_t ntp_ms = report.ms() + 100000;
+    Info info;
+    info.latest_receive_time = last_receive_;
+    info.latest_received_capture_rtp_timestamp = timestamp;
+    info.capture_time_rtp = report.ms() * frequency_ / 1000 + rtp_offset;
+    info.rtp_clock_rate_hz = expose_clock_rate ? frequency_ : 0;
+    info.capture_time_ntp = NtpTime(ntp_ms / 1000,
+        static_cast<uint32_t>((ntp_ms % 1000) * (uint64_t{1} << 32) / 1000));
+    info.current_delay = std::max(TimeDelta::Millis(delay_ms), floor);
+    if (video_buffer.has_value()) {
+      const TimeDelta buffer = video_target.value_or(*video_buffer);
+      info.current_delay = std::max(TimeDelta::Zero(), buffer + transport_offset);
+      info.video_clock_offset = -transport_offset;
+    }
+    return info;
+  }
+  std::optional<PlayoutInfo> GetPlayoutRtpTimestamp() const override {
+    if (!actual_playout_delay) return std::nullopt;
+    const Timestamp instant = clock_->CurrentTime() - playout_age;
+    const uint32_t rtp = (instant - *actual_playout_delay).ms() *
+        frequency_ / 1000 + rtp_offset;
+    return PlayoutInfo{.time = instant, .rtp_timestamp = rtp};
+  }
+  bool SetMinimumPlayoutDelay(TimeDelta delay) override {
+    floor = delay;
+    return true;
+  }
+  void SetVideoSyncDelay(std::optional<TimeDelta> delay) override {
+    video_target = delay;
+    ++video_updates;
+  }
+  void SetEstimatedPlayoutNtpTimestamp(NtpTime, Timestamp) override {}
+  std::optional<Timestamp> report_time;
+  bool expose_clock_rate = false;
+  uint32_t rtp_offset = 0;
+  bool receiving = true;
+  bool has_info = true;
+  int delay_ms;
+  std::optional<TimeDelta> actual_playout_delay;
+  TimeDelta playout_age = TimeDelta::Zero();
+  TimeDelta receive_age = TimeDelta::Zero();
+  TimeDelta floor = TimeDelta::Zero();
+  std::optional<TimeDelta> video_buffer;
+  std::optional<TimeDelta> video_target;
+  TimeDelta transport_offset = TimeDelta::Zero();
+  int video_updates = 0;
+ private:
+  Clock* const clock_;
+  const uint32_t id_;
+  const int frequency_;
+  mutable Timestamp last_receive_;
+};
