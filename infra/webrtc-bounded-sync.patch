+TEST(TimestampExtrapolatorTest, RecoversClockRateAfterNetworkDelay) {
+  SimulatedClock clock(Timestamp::Millis(1337));
+  TimestampExtrapolator extrapolator(clock.CurrentTime(), CreateTestFieldTrials());
+  const Timestamp start = clock.CurrentTime();
+  std::vector<std::pair<Timestamp, uint32_t>> arrivals;
+  for (int i = 0; i < 650; ++i) {
+    const Timestamp capture = start + TimeDelta::Millis(i * 50);
+    const TimeDelta network_delay =
+        TimeDelta::Millis(i >= 50 && i < 350 ? 150 : 0);
+    arrivals.emplace_back(capture + network_delay, 90000 + i * 4500);
+  }
+  // Delay transitions reorder frames. Feed real arrival order without moving
+  // the receiver clock backwards or resetting the estimator between phases.
+  std::sort(arrivals.begin(), arrivals.end());
+  for (const auto& [arrival, rtp] : arrivals) {
+    clock.AdvanceTime(arrival - clock.CurrentTime());
+    extrapolator.Update(clock.CurrentTime(), rtp);
+  }
+  const uint32_t last_rtp = 90000 + 649 * 4500;
+  auto last = extrapolator.ExtrapolateLocalTime(last_rtp);
+  auto next = extrapolator.ExtrapolateLocalTime(last_rtp + 90000);
+  ASSERT_TRUE(last.has_value());
+  ASSERT_TRUE(next.has_value());
+  EXPECT_LE((*last - clock.CurrentTime()).Abs(), TimeDelta::Millis(1));
+  // A transient path delay must not become a persistent sender-clock drift.
+  EXPECT_LE((*next - clock.CurrentTime() - TimeDelta::Seconds(1)).Abs(),
+            TimeDelta::Millis(1));
+}
