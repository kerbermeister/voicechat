+// Bound receiver video buffering while keeping ordinary speech responsive.
+// Explicit settings, codecs and audio processing remain unchanged.
+static NSString *FieldTrialsWithDefaultVideoPlayout(NSString *fieldTrials) {
+  NSString *trials = fieldTrials ?: @"";
+  NSString *defaultTrial = @"WebRTC-ForcePlayoutDelay/min_ms:0,max_ms:10000/";
+  if (trials.length == 0) return defaultTrial;
+  NSArray<NSString *> *parts = [trials componentsSeparatedByString:@"/"];
+  if (parts.count % 2 == 0 || ![trials hasSuffix:@"/"]) return trials;
+  for (NSUInteger i = 0; i + 1 < parts.count; i += 2) {
+    // Leave invalid input to the existing native validation, never repair it.
+    if (parts[i].length == 0 || parts[i + 1].length == 0) return trials;
+    if ([parts[i] isEqualToString:@"WebRTC-ForcePlayoutDelay"]) return trials;
+  }
+  return [trials stringByAppendingString:defaultTrial];
+}

