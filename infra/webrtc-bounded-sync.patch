+namespace {
+// Receive delay and sync floor are independent, just as device/base delay and
+// NetEq's synchronization minimum are independent in the real audio stream.
+class SyncTestStream : public Syncable {
+ public:
+  SyncTestStream(Clock* clock, uint32_t id, int frequency, int delay_ms)
+      : clock_(clock), id_(id), frequency_(frequency), delay_ms_(delay_ms),
+        last_receive_(clock->CurrentTime()) {}
+  uint32_t id() const override { return id_; }
+  std::optional<Info> GetInfo() const override {
+    if (!has_info) return std::nullopt;
+    if (receiving) last_receive_ = clock_->CurrentTime();
+    const uint32_t timestamp = last_receive_.ms() * frequency_ / 1000;
+    const int64_t ntp_ms = last_receive_.ms() + 100000;
+    Info info;
+    info.latest_receive_time = last_receive_;
+    info.latest_received_capture_rtp_timestamp = timestamp;
+    info.capture_time_rtp = timestamp;
+    info.capture_time_ntp = NtpTime(ntp_ms / 1000,
+        static_cast<uint32_t>((ntp_ms % 1000) * (uint64_t{1} << 32) / 1000));
+    info.current_delay = std::max(TimeDelta::Millis(delay_ms_), floor);
+    return info;
+  }
+  std::optional<PlayoutInfo> GetPlayoutRtpTimestamp() const override {
+    return std::nullopt;
+  }
+  bool SetMinimumPlayoutDelay(TimeDelta delay) override {
+    floor = delay;
+    ++updates;
+    return true;
+  }
+  void SetEstimatedPlayoutNtpTimestamp(NtpTime, Timestamp) override {}
+  bool receiving = true;
+  bool has_info = true;
+  TimeDelta floor = TimeDelta::Zero();
+  int updates = 0;
+ private:
+  Clock* const clock_;
+  const uint32_t id_;
+  const int frequency_;
+  const int delay_ms_;
+  mutable Timestamp last_receive_;
+};
+
+class RtpStreamsSynchronizerTest : public ::testing::Test {
+ protected:
+  RtpStreamsSynchronizerTest()
+      : time_(Timestamp::Millis(1337)),
+        env_(CreateEnvironment(time_.GetClock(), time_.GetTaskQueueFactory())),
+        audio_(time_.GetClock(), 1, 8000, 40),
+        video_(time_.GetClock(), 2, 90000, 500),
+        sync_(std::make_unique<internal::RtpStreamsSynchronizer>(
+            env_, time_.GetMainThread(), &video_)) {
+    sync_->ConfigureSync(&audio_);
+    time_.AdvanceTime(TimeDelta::Seconds(12));
+    EXPECT_GT(audio_.floor, TimeDelta::Millis(200));
+  }
+  GlobalSimulatedTimeController time_;
+  Environment env_;
+  SyncTestStream audio_;
+  SyncTestStream video_;
+  // Destroy the synchronizer before its streams, matching Call ownership.
+  std::unique_ptr<internal::RtpStreamsSynchronizer> sync_;
+};
+
+TEST_F(RtpStreamsSynchronizerTest, ReleasesFloorsWhenVideoStopsAndResumes) {
+  const TimeDelta previous = audio_.floor;
+  video_.receiving = false;
+  time_.AdvanceTime(TimeDelta::Seconds(1));
+  EXPECT_EQ(audio_.floor, previous);
+  time_.AdvanceTime(TimeDelta::Seconds(1));
+  EXPECT_EQ(audio_.floor, TimeDelta::Zero());
+  EXPECT_EQ(video_.floor, TimeDelta::Zero());
+  const int updates = audio_.updates;
+  time_.AdvanceTime(TimeDelta::Seconds(5));
+  EXPECT_EQ(audio_.updates, updates);
+  EXPECT_EQ(audio_.GetInfo()->current_delay, TimeDelta::Millis(40));
+  video_.receiving = true;
+  time_.AdvanceTime(TimeDelta::Seconds(12));
+  EXPECT_GT(audio_.floor, TimeDelta::Millis(200));
+}
+
+TEST_F(RtpStreamsSynchronizerTest, ReleasesFloorsWhenAudioStops) {
+  sync_.reset();
+  SyncTestStream delayed_audio(time_.GetClock(), 3, 8000, 500);
+  SyncTestStream low_delay_video(time_.GetClock(), 4, 90000, 40);
+  internal::RtpStreamsSynchronizer sync(env_, time_.GetMainThread(),
+                                        &low_delay_video);
+  sync.ConfigureSync(&delayed_audio);
+  time_.AdvanceTime(TimeDelta::Seconds(12));
+  EXPECT_GT(low_delay_video.floor, TimeDelta::Millis(200));
+  delayed_audio.receiving = false;
+  time_.AdvanceTime(TimeDelta::Seconds(2));
+  EXPECT_EQ(delayed_audio.floor, TimeDelta::Zero());
+  EXPECT_EQ(low_delay_video.floor, TimeDelta::Zero());
+  EXPECT_EQ(delayed_audio.GetInfo()->current_delay, TimeDelta::Millis(500));
+}
+
+TEST_F(RtpStreamsSynchronizerTest, ReleasesFloorsWhenInfoDisappears) {
+  video_.has_info = false;
+  time_.AdvanceTime(TimeDelta::Seconds(1));
+  EXPECT_EQ(audio_.floor, TimeDelta::Zero());
+  EXPECT_EQ(video_.floor, TimeDelta::Zero());
+}
+
+TEST_F(RtpStreamsSynchronizerTest, DetachAndReassignReleaseOldFloors) {
+  sync_->ConfigureSync(nullptr);
+  EXPECT_EQ(audio_.floor, TimeDelta::Zero());
+  EXPECT_EQ(video_.floor, TimeDelta::Zero());
+  sync_->ConfigureSync(&audio_);
+  time_.AdvanceTime(TimeDelta::Seconds(12));
+  EXPECT_GT(audio_.floor, TimeDelta::Millis(200));
+  SyncTestStream other(time_.GetClock(), 3, 8000, 250);
+  sync_->ConfigureSync(&other);
+  EXPECT_EQ(audio_.floor, TimeDelta::Zero());
+  time_.AdvanceTime(TimeDelta::Seconds(1));
+  EXPECT_EQ(other.GetInfo()->current_delay, TimeDelta::Millis(250));
+  sync_->ConfigureSync(nullptr);
+}
+
+TEST_F(RtpStreamsSynchronizerTest, DestructionReleasesAudioFloor) {
+  sync_.reset();
+  EXPECT_EQ(audio_.floor, TimeDelta::Zero());
+}
