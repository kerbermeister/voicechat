+TEST_F(RtpStreamsSynchronizerTest, CapsOnlyAddedAudioSynchronizationDelay) {
+  for (int second = 0; second < 30; ++second) {
+    time_.AdvanceTime(TimeDelta::Seconds(1));
+    EXPECT_GE(audio_.floor, TimeDelta::Zero());
+    EXPECT_LE(audio_.floor, TimeDelta::Millis(80));
+  }
+  EXPECT_GT(audio_.floor, TimeDelta::Zero());
+}
+
+TEST_F(StreamSynchronizationTest, AudioSyncBudgetPreservesExplicitBase) {
+  StreamSynchronization sync(0, 0, 80);
+  sync.SetTargetBufferingDelay(500);
+  int audio_delay_ms = 500;
+  for (int second = 0; second < 30; ++second) {
+    int video_delay_ms = 1000;
+    sync.ComputeDelays(200, audio_delay_ms, &audio_delay_ms, &video_delay_ms);
+    EXPECT_GE(audio_delay_ms, 500);
+    EXPECT_LE(audio_delay_ms, 580);
+    EXPECT_GE(video_delay_ms, 500);
+  }
+  EXPECT_EQ(audio_delay_ms, 580);
