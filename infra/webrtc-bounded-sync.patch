+TEST(VCMTimingTest, SyncDelayUsesCurrentDelayAfterVideoJitter) {
+  FieldTrials field_trials = CreateTestFieldTrials();
+  SimulatedClock clock(0);
+  VCMTiming timing(&clock, field_trials);
+  timing.SetMinimumDelay(TimeDelta::Millis(20));
+  timing.SetMinimumDelay(TimeDelta::Seconds(2));
+
+  EXPECT_EQ(timing.GetTimings().CurrentDelay(), TimeDelta::Millis(20));
+  // Retain the raw estimate for detecting excessive jitter and resetting buffers.
+  EXPECT_GT(timing.TargetVideoDelay(), TimeDelta::Seconds(2));
+}
+
+TEST(VCMTimingTest, SyncDelayRespectsBoundsAndAudioDeviceMinimum) {
+  FieldTrials field_trials = CreateTestFieldTrials();
+  SimulatedClock clock(0);
+  VCMTiming timing(&clock, field_trials);
+  timing.SetMinimumDelay(TimeDelta::Millis(200));
+  timing.set_playout_delay({TimeDelta::Millis(40), TimeDelta::Millis(130)});
+  EXPECT_EQ(timing.GetTimings().CurrentDelay(), TimeDelta::Millis(130));
+
+  // A/V sync may legitimately add video delay to match an audio device.
+  timing.set_playout_delay({TimeDelta::Millis(250), TimeDelta::Seconds(10)});
+  EXPECT_EQ(timing.GetTimings().CurrentDelay(), TimeDelta::Millis(250));
+}
+
+TEST(VCMTimingTest, SyncDelayUsesLowLatencyRenderingPath) {
+  FieldTrials field_trials = CreateTestFieldTrials();
+  SimulatedClock clock(0);
+  VCMTiming timing(&clock, field_trials);
+  timing.SetMinimumDelay(TimeDelta::Seconds(2));
+  timing.set_playout_delay({TimeDelta::Zero(), TimeDelta::Millis(130)});
+
+  EXPECT_EQ(timing.GetTimings().CurrentDelay(), TimeDelta::Zero());
+  EXPECT_EQ(timing.RenderTime(0, clock.CurrentTime()), Timestamp::Zero());
+  EXPECT_GT(timing.TargetVideoDelay(), TimeDelta::Seconds(2));
+}
