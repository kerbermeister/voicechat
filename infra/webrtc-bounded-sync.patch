+std::optional<int64_t> CaptureTimeMs(
+    const StreamSynchronization::Measurements& stream,
+    const Syncable::Info& info,
+    uint32_t rtp_timestamp) {
+  const NtpTime measured = stream.rtp_to_ntp.Estimate(rtp_timestamp);
+  if (measured.Valid())
+    return measured.ToMs();
+  if (!info.capture_time_ntp.Valid() || info.rtp_clock_rate_hz <= 0)
+    return std::nullopt;
+  // One authenticated sender report and the negotiated rate are enough for
+  // startup. Do not seed the fitted clock with a synthetic second report.
+  const int64_t delta = static_cast<int32_t>(rtp_timestamp - info.capture_time_rtp);
+  if (std::abs(delta) > int64_t{info.rtp_clock_rate_hz} * 10)
+    return std::nullopt;
+  const int64_t capture_ms = info.capture_time_ntp.ToMs() +
+      delta * 1000 / info.rtp_clock_rate_hz;
+  return capture_ms > 0 ? std::optional<int64_t>(capture_ms) : std::nullopt;
+}

