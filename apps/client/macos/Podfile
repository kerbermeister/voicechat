require 'digest'

platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  pod 'WebRTC-SDK', :podspec => '../../../vendor/webrtc-sdk/WebRTC-SDK.podspec'

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    if target.name == 'flutter_webrtc'
      renderers = target.source_build_phase.files_references.select do |reference|
        File.basename(reference.path.to_s) == 'FlutterRTCVideoRenderer.m'
      end
      raise 'Expected one flutter_webrtc renderer source' unless renderers.length == 1
      renderer = renderers.first
      replacement = File.expand_path('Compatibility/FlutterRTCVideoRenderer.m', __dir__)
      original = renderer.real_path.to_s
      expected = '8878ef050b8c1d1dfc273ad053cb407c00cd26792f4c4e15899709b07ab08576'
      unless original == replacement || Digest::SHA256.file(original).hexdigest == expected
        raise 'Review the changed upstream flutter_webrtc renderer before building'
      end
      renderer.path = replacement
      renderer.source_tree = '<absolute>'
    end
    if target.name == 'connectivity_plus' && Gem::Version.new(`xcrun --sdk macosx --show-sdk-version`.strip) < Gem::Version.new('26.0')
      source = File.join(__dir__, 'Compatibility', 'LegacyNetworkSDK.swift')
      reference = installer.pods_project.main_group.new_file(source)
      target.source_build_phase.add_file_reference(reference)
    end
  end
end
